<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Responsive -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Información del sitio -->
    <title>La Milenita</title>
    <meta name="keywords" content="La Milenita, papas tostadas, Costa Rica, snacks">
    <meta name="description" content="La Milenita - El sabor tradicional costarricense">
    <meta name="author" content="La Milenita">

    <!-- Iconos -->
    <link rel="shortcut icon" href="~/images/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">

    <!-- CSS de la plantilla -->
    <link rel="stylesheet" href="~/css/style.css">

    <!-- Responsive -->
    <link rel="stylesheet" href="~/css/responsive.css">

    <!-- Custom -->
    <link rel="stylesheet" href="~/css/custom.css">

    <!-- CSS personalizado La Milenita -->
    <link rel="stylesheet" href="~/css/milenita.css">

</head>


<body>


    <!-- ===================================================
         BARRA SUPERIOR
         =================================================== -->

    <div class="milenita-topbar">

        <div class="container">

            <div class="milenita-topbar-content">

                <div class="topbar-left">

                    <span>
                        <i class="fas fa-map-marker-alt"></i>
                        Santa Bárbara, Heredia
                    </span>

                    <span>
                        <i class="fas fa-heart"></i>
                        Producto costarricense
                    </span>

                </div>


                <div class="topbar-right">

                    <a href="https://www.instagram.com/lamilenitasa/"
                       target="_blank">

                        <i class="fab fa-instagram"></i>
                        @@lamilenitasa

                    </a>

                </div>

            </div>

        </div>

    </div>



    <!-- ===================================================
         NAVBAR
         =================================================== -->

    <header class="main-header">

        <nav class="navbar navbar-expand-lg navbar-light bg-light navbar-default bootsnav">

            <div class="container">


                <!-- Logo -->

                <div class="navbar-header">

                    <button class="navbar-toggler"
                            type="button"
                            data-toggle="collapse"
                            data-target="#navbar-menu"
                            aria-controls="navbar-menu"
                            aria-expanded="false"
                            aria-label="Menú">

                        <i class="fa fa-bars"></i>

                    </button>


                    <a class="navbar-brand"
                       href="@Url.Action("Index", "Home")">

                        <img src="~/images/logo_milenita.jpeg"
                             class="logo-milenita"
                             alt="La Milenita">

                    </a>

                </div>



                <!-- Menú -->

                <div class="collapse navbar-collapse"
                     id="navbar-menu">

                    <ul class="nav navbar-nav ml-auto"
                        data-in="fadeInDown"
                        data-out="fadeOutUp">


                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("Index", "Home")">

                                INICIO

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("Shop", "Home")">

                                PRODUCTOS

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("About", "Home")">

                                NOSOTROS

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("Gallery", "Home")">

                                GALERÍA

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("ContactUs", "Home")">

                                CONTACTO

                            </a>

                        </li>


                    </ul>

                </div>



                <!-- Iconos derecha -->

                <div class="attr-nav">

                    <ul>


                        <!-- Buscador -->

                        <li class="search">

                            <a href="#">

                                <i class="fa fa-search"></i>

                            </a>

                        </li>



                        <!-- Cuenta -->

                        <li>

                            <a href="@Url.Action("Login", "Home")">

                                <i class="fa fa-user"></i>

                            </a>

                        </li>



                        <!-- Carrito -->

                        <li class="side-menu">

                            <a href="@Url.Action("Cart", "Home")">

                                <i class="fa fa-shopping-bag"></i>

                                <span class="badge">3</span>

                                <p>Carrito</p>

                            </a>

                        </li>


                    </ul>

                </div>


            </div>



            <!-- ===================================================
                 MENÚ LATERAL DEL CARRITO
                 =================================================== -->

            <div class="side">

                <a href="#"
                   class="close-side">

                    <i class="fa fa-times"></i>

                </a>


                <li class="cart-box">

                    <ul class="cart-list">


                        <li>

                            <a href="#"
                               class="photo">

                                <img src="~/images/milenita-pequena.png"
                                     class="cart-thumb"
                                     alt="Milenita pequeña">

                            </a>

                            <h6>
                                <a href="#">
                                    Milenita Pequeña
                                </a>
                            </h6>

                            <p>
                                1 x
                                <span class="price">
                                    ₡1.000
                                </span>
                            </p>

                        </li>



                        <li>

                            <a href="#"
                               class="photo">

                                <img src="~/images/milenita-mediana.png"
                                     class="cart-thumb"
                                     alt="Milenita mediana">

                            </a>

                            <h6>
                                <a href="#">
                                    Milenita Mediana
                                </a>
                            </h6>

                            <p>
                                1 x
                                <span class="price">
                                    ₡1.500
                                </span>
                            </p>

                        </li>



                        <li>

                            <a href="#"
                               class="photo">

                                <img src="~/images/milenita-grande.png"
                                     class="cart-thumb"
                                     alt="Milenita grande">

                            </a>

                            <h6>
                                <a href="#">
                                    Milenita Grande
                                </a>
                            </h6>

                            <p>
                                1 x
                                <span class="price">
                                    ₡2.000
                                </span>
                            </p>

                        </li>



                        <li class="total">

                            <a href="@Url.Action("Cart", "Home")"
                               class="btn btn-default hvr-hover btn-cart">

                                VER CARRITO

                            </a>

                            <span class="float-right">

                                <strong>Total:</strong>

                                ₡4.500

                            </span>

                        </li>


                    </ul>

                </li>

            </div>


        </nav>

    </header>



    <!-- ===================================================
         BUSCADOR
         =================================================== -->

    <div class="top-search">

        <div class="container">

            <div class="input-group">

                <span class="input-group-addon">

                    <i class="fa fa-search"></i>

                </span>


                <input type="text"
                       class="form-control"
                       placeholder="Buscar productos...">


                <span class="input-group-addon close-search">

                    <i class="fa fa-times"></i>

                </span>

            </div>

        </div>

    </div>



    <!-- ===================================================
         CONTENIDO DE CADA VISTA
         =================================================== -->

    @RenderBody()



    <!-- ===================================================
         FOOTER LA MILENITA
         =================================================== -->

    <footer class="footer-milenita">

        <div class="container">

            <div class="row">


                <!-- Información -->

                <div class="col-lg-4 col-md-6 mb-4">

                    <img src="~/images/logo_milenita.jpeg"
                         class="footer-logo"
                         alt="La Milenita">


                    <p class="footer-description">

                        El sabor tradicional costarricense
                        que acompaña tus mejores momentos.

                    </p>

                </div>



                <!-- Enlaces -->

                <div class="col-lg-4 col-md-6 mb-4">

                    <h4>Enlaces</h4>


                    <ul class="footer-links">

                        <li>

                            <a href="@Url.Action("Index", "Home")">

                                Inicio

                            </a>

                        </li>


                        <li>

                            <a href="@Url.Action("Shop", "Home")">

                                Productos

                            </a>

                        </li>


                        <li>

                            <a href="@Url.Action("About", "Home")">

                                Nosotros

                            </a>

                        </li>


                        <li>

                            <a href="@Url.Action("ContactUs", "Home")">

                                Contacto

                            </a>

                        </li>

                    </ul>

                </div>



                <!-- Contacto -->

                <div class="col-lg-4 col-md-6 mb-4">

                    <h4>Contacto</h4>


                    <p>

                        <i class="fas fa-map-marker-alt"></i>

                        Santa Bárbara, Heredia

                    </p>


                    <p>

                        <a href="https://www.instagram.com/lamilenitasa/"
                           target="_blank">

                            <i class="fab fa-instagram"></i>

                            @@lamilenitasa

                        </a>

                    </p>

                </div>


            </div>

        </div>

    </footer>




    <div class="footer-copyright-milenita">

        <p>

            &copy; 2026 La Milenita.
            Todos los derechos reservados.

        </p>

    </div>



  

    <a href="#"
       id="back-to-top"
       title="Volver arriba"
       style="display: none;">

        &uarr;

    </a>




    <script src="~/js/jquery-3.2.1.min.js"></script>

    <script src="~/js/popper.min.js"></script>

    <script src="~/js/bootstrap.min.js"></script>


    <!-- Plugins -->

    <script src="~/js/jquery.superslides.min.js"></script>

    <script src="~/js/bootstrap-select.js"></script>

    <script src="~/js/inewsticker.js"></script>

    <script src="~/js/bootsnav.js"></script>

    <script src="~/js/images-loded.min.js"></script>

    <script src="~/js/isotope.min.js"></script>

    <script src="~/js/owl.carousel.min.js"></script>

    <script src="~/js/baguetteBox.min.js"></script>

    <script src="~/js/form-validator.min.js"></script>

    <script src="~/js/contact-form-script.js"></script>

    <script src="~/js/jquery.nicescroll.min.js"></script>

    <script src="~/js/jquery-ui.js"></script>

    <script src="~/js/custom.js"></script>

    <script>
        function togglePassword(fieldId, btn) {
            var field = document.getElementById(fieldId);
            var icon = btn.querySelector('i');
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>

</body>

</html>