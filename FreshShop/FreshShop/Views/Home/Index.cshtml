@{
    ViewData["Title"] = "Inicio";
}


<section class="milenita-hero">
    <div class="container">
        <div class="row align-items-center min-vh-75">

            <div class="col-lg-6">
                <div class="hero-content">
                    <span class="hero-badge">
                        SABOR 100% TICO 🇨🇷
                    </span>

                    <h1>
                        El sabor que hace
                        <span>crunch</span>
                        en cada momento
                    </h1>

                    <p>
                        Disfrutá el sabor tradicional de
                        <strong>La Milenita</strong>.
                        Papas tostadas perfectas para compartir,
                        acompañar tus comidas o disfrutar cuando querás.
                    </p>

                    <div class="hero-buttons">
                        <a href="#productos" class="btn btn-milenita">
                            <i class="fas fa-shopping-bag"></i>
                            Ver productos
                        </a>

                        <a href="#nosotros" class="btn btn-outline-milenita">
                            Conocé La Milenita
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 text-center">
                <div class="hero-image">
                    <img src="~/images/logo_milenita.jpeg"
                         class="img-fluid"
                         alt="Papas Tostadas La Milenita" />

                    <div class="hero-circle"></div>
                </div>
            </div>

        </div>
    </div>
</section>


<section class="milenita-beneficios">
    <div class="container">
        <div class="row g-4 text-center">

            <div class="col-md-4">
                <div class="beneficio-card">
                    <div class="beneficio-icon">
                        <i class="fas fa-star"></i>
                    </div>

                    <h4>Sabor tradicional</h4>

                    <p>
                        El sabor característico de La Milenita
                        que ha acompañado a generaciones.
                    </p>
                </div>
            </div>


            <div class="col-md-4">
                <div class="beneficio-card">
                    <div class="beneficio-icon">
                        <i class="fas fa-cookie-bite"></i>
                    </div>

                    <h4>Extra crujientes</h4>

                    <p>
                        Papas tostadas con la textura perfecta
                        para disfrutar en cualquier momento.
                    </p>
                </div>
            </div>


            <div class="col-md-4">
                <div class="beneficio-card">
                    <div class="beneficio-icon">
                        <i class="fas fa-heart"></i>
                    </div>

                    <h4>Hechas en Costa Rica</h4>

                    <p>
                        Un producto nacional con historia,
                        tradición y mucho sabor.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<section id="productos" class="milenita-productos">

    <div class="container">

        <div class="section-title text-center">

            <span>NUESTROS FAVORITOS</span>

            <h2>Encontrá tu Milenita</h2>

            <p>
                Diferentes tamaños para cada antojo.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="producto-card">

                    <div class="producto-etiqueta">
                        Ideal para vos
                    </div>

                    <div class="producto-imagen">

                        <img src="~/images/bolsa_pequena.jpeg"
                             class="img-fluid"
                             alt="Milenita pequeña" />

                    </div>

                    <div class="producto-info">

                        <h3>Milenita Pequeña</h3>

                        <p>
                            El tamaño perfecto para matar el antojo
                            durante el día.
                        </p>

                        <a href="#" class="producto-link">
                            Ver producto
                            <i class="fas fa-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="producto-card producto-destacado">

                    <div class="producto-etiqueta">
                        Más popular
                    </div>

                    <div class="producto-imagen">

                        <img src="~/images/bolsa_mediana.jpeg"
                             class="img-fluid"
                             alt="Milenita mediana" />

                    </div>

                    <div class="producto-info">

                        <h3>Milenita Mediana</h3>

                        <p>
                            Para compartir... o para cuando
                            simplemente querés más.
                        </p>

                        <a href="#" class="producto-link">
                            Ver producto
                            <i class="fas fa-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-4 col-md-6">

                <div class="producto-card">

                    <div class="producto-etiqueta">
                        Para compartir
                    </div>

                    <div class="producto-imagen">

                        <img src="~/images/bolsa_kilo.jpeg"
                             class="img-fluid"
                             alt="Milenita grande" />

                    </div>

                    <div class="producto-info">

                        <h3>Milenita Grande</h3>

                        <p>
                            Mucho más crunch para compartir
                            con familia y amigos.
                        </p>

                        <a href="#" class="producto-link">
                            Ver producto
                            <i class="fas fa-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="milenita-banner">

    <div class="container">

        <div class="banner-content">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <span>UN CLÁSICO COSTARRICENSE</span>

                    <h2>
                        Un buen momento siempre puede
                        ser mejor con La Milenita.
                    </h2>

                    <p>
                        Para reuniones, fiestas, almuerzos
                        o simplemente para disfrutar.
                    </p>

                    <a href="#productos"
                       class="btn btn-banner">

                        Descubrir productos

                    </a>

                </div>


                <div class="col-lg-5 text-center">

                    <img src="~/images/logo_milenita.jpeg"
                         class="img-fluid banner-product"
                         alt="La Milenita" />

                </div>

            </div>

        </div>

    </div>

</section>


<section id="nosotros" class="milenita-nosotros">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="nosotros-image">

                    <img src="~/images/sticker_moderno.jpeg"
                         class="img-fluid"
                         alt="La Milenita Costa Rica" />

                </div>

            </div>


            <div class="col-lg-6">

                <div class="nosotros-content">

                    <span>SOBRE NOSOTROS</span>

                    <h2>
                        El auténtico sabor de
                        La Milenita
                    </h2>

                    <p>
                        La Milenita es una empresa costarricense
                        dedicada a la elaboración de productos
                        alimenticios y reconocida principalmente
                        por sus tradicionales papas tostadas.
                    </p>

                    <p>
                        Desde Santa Bárbara de Heredia,
                        nuestras papas llegan a hogares
                        y comercios para convertirse en
                        parte de esos momentos que se disfrutan
                        mejor acompañados.
                    </p>

                    <a href="#" class="btn btn-milenita">
                        Conocer nuestra historia
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="milenita-instagram">

    <div class="container">

        <div class="milenita-instagram-box">

            <div class="milenita-instagram-info">

                <i class="fab fa-instagram milenita-instagram-icon"></i>

                <span class="instagram-label">
                    SEGUINOS
                </span>

                <h2>
                    Encontranos en Instagram
                </h2>

                <p>
                    Conocé nuestros productos, novedades
                    y puntos de venta.
                </p>

            </div>

            <div class="milenita-instagram-action">

                <a href="https://www.instagram.com/lamilenitasa/"
                   target="_blank"
                   class="btn-instagram-milenita">

                    <i class="fab fa-instagram"></i>

                    @@lamilenitasa

                </a>

            </div>

        </div>

    </div>

</section>